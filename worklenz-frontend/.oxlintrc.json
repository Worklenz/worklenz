{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": { "correctness": "warn" },
  "rules": {
    "no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["dist", "build", "node_modules", "public"]
}
