# ============================================================================
# Worklenz Self-Hosted Configuration
# ============================================================================
# Copy this file to .env and configure according to your needs
# Required fields are marked with (REQUIRED)
# ============================================================================

# ============================================================================
# DEPLOYMENT MODE
# ============================================================================
# Used by management scripts. The supplied docker-compose.yml always starts its
# bundled services; changing this value does not switch to external services.
DEPLOYMENT_MODE=express

# OSS feature entitlement. Keep this as self_hosted: Planner, Finance, and
# Client Portal are included for every organization in this installation.
WORKLENZ_DEPLOYMENT_MODE=self_hosted

# ============================================================================
# DOMAIN AND URL CONFIGURATION
# ============================================================================
# Your domain name (e.g., worklenz.example.com)
# For localhost testing: localhost
# For production: your-domain.com
DOMAIN=localhost

# Base URL for the API (used by frontend to connect to backend)
# For production with HTTPS: https://your-domain.com
# For localhost HTTPS: https://localhost
VITE_API_URL=https://localhost

# WebSocket URL for real-time features
# For production with HTTPS: wss://your-domain.com
# For localhost: wss://localhost
VITE_SOCKET_URL=wss://localhost

# Frontend URL (used by backend for CORS and redirects)
# Should match your domain URL
FRONTEND_URL=https://localhost

# CORS Configuration
# For development: * (allows all origins)
# For production: your-domain.com or https://your-domain.com
SERVER_CORS=*
SOCKET_IO_CORS=https://localhost

# ============================================================================
# PORT CONFIGURATION
# ============================================================================
# Ports exposed to the host machine
HTTP_PORT=80
HTTPS_PORT=443

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DB_NAME=worklenz_db
DB_USER=postgres
# Database password (REQUIRED) - Change this!
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123
DB_MAX_CLIENTS=50
USE_PG_NATIVE=false

# Advanced: External PostgreSQL (only if not using bundled PostgreSQL)
# DB_HOST=your-postgres-host.com
# DB_PORT=5432

# ============================================================================
# SECURITY SECRETS
# ============================================================================
# Generate secure random strings with: openssl rand -hex 32

# Session Secret (REQUIRED)
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_HEX_STRING_32_CHARS

# Cookie Secret (REQUIRED)
COOKIE_SECRET=CHANGE_THIS_TO_RANDOM_HEX_STRING_32_CHARS

# JWT Secret (REQUIRED)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_HEX_STRING_32_CHARS

# Session cookie name
SESSION_NAME=worklenz.sid

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis settings for deployments that configure a separate Redis service.
# The supplied docker-compose.yml does not start Redis.
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_DB=0

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Storage provider: s3 (for SeaweedFS/AWS S3), azure (for Azure Blob)
STORAGE_PROVIDER=s3

# ----------------------------------------------------------------------------
# SeaweedFS Configuration (Express Mode - Default, S3-compatible)
# ----------------------------------------------------------------------------
S3_BUCKET=worklenz-bucket
S3_ACCESS_KEY_ID=worklenz
# SeaweedFS secret access key (REQUIRED) - Change this!
S3_SECRET_ACCESS_KEY=CHANGE_THIS_SEAWEEDFS_SECRET
# Internal S3 API endpoint used by the backend container
S3_ENDPOINT=http://seaweedfs:8333
# Public bucket URL used in attachment links
S3_PUBLIC_URL=http://localhost:8333/worklenz-bucket
# Port exposed on the Docker host
SEAWEEDFS_S3_PORT=8333

# ----------------------------------------------------------------------------
# AWS S3 Configuration (Advanced Mode - External S3)
# ----------------------------------------------------------------------------
# Uncomment and configure if using real AWS S3 (set STORAGE_PROVIDER=s3)
# S3_REGION=us-east-1
# S3_BUCKET=your-worklenz-bucket
# S3_ACCESS_KEY_ID=your_aws_access_key_id
# S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
# S3_ENDPOINT=  # Leave empty to use the AWS S3 endpoint
# S3_PUBLIC_URL=https://your-worklenz-bucket.s3.us-east-1.amazonaws.com

# ----------------------------------------------------------------------------
# Azure Blob Storage Configuration (Advanced Mode)
# ----------------------------------------------------------------------------
# Uncomment and configure if using Azure Blob (set STORAGE_PROVIDER=azure)
# AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
# AZURE_STORAGE_CONTAINER=worklenz-uploads
# AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
# AZURE_STORAGE_URL=https://your_account.blob.core.windows.net

# ============================================================================
# GOOGLE OAUTH (Optional)
# ============================================================================
# Configure if you want to enable Google login
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
# VITE_ENABLE_GOOGLE_LOGIN=true

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# Configure your standards-compliant SMTP relay to enable invitations and
# email notifications. SMTP is the default for this OSS distribution.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Worklenz <noreply@your-domain.com>"
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Public hostname used in Client Portal invitation and password-reset links.
CLIENT_PORTAL_HOSTNAME=client.your-domain.com

ENABLE_EMAIL_CRONJOBS=false
# CONTACT_US_EMAIL=contact@your-domain.com

# ============================================================================
# GOOGLE RECAPTCHA (Optional)
# ============================================================================
# Configure if you want to enable reCAPTCHA protection
# Get credentials from: https://www.google.com/recaptcha/admin
# GOOGLE_CAPTCHA_SECRET_KEY=your-secret-key
# GOOGLE_CAPTCHA_PASS_SCORE=0.8
# VITE_ENABLE_RECAPTCHA=true
# VITE_RECAPTCHA_SITE_KEY=your-site-key

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application title (shown in browser tab)
VITE_APP_TITLE=Worklenz

# Enable survey modal (user feedback)
VITE_ENABLE_SURVEY_MODAL=false

# Timezone
TZ=UTC

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
# Used by management scripts; the supplied db-backup container uses a fixed
# 30-day retention regardless of this setting.
BACKUP_RETENTION_DAYS=30

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================
# Used by management scripts; nginx in the supplied Compose file requires
# a certificate regardless of this setting.
ENABLE_SSL=false

# Optional for custom certificate tooling; the supplied installer does not issue
# or renew Let's Encrypt certificates.
# LETSENCRYPT_EMAIL=admin@your-domain.com

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Docker Hub username (for building and pushing custom images)
# Pre-built images are available at: chamikajaycey/worklenz-backend and chamikajaycey/worklenz-frontend
DOCKER_USERNAME=chamikajaycey

# ============================================================================
# ADVANCED CONFIGURATION (Usually no need to change)
# ============================================================================
# Backend port inside container
PORT=3000

# Node environment
NODE_ENV=production

# ============================================================================
# GITHUB INTEGRATION (Optional, software projects)
# ============================================================================
# Leave unset to hide the feature. See docs/SELF_HOSTING.md for the GitHub App setup.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents (\n escaped) or base64 of the PEM
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Set to false to disable the webhook processing worker on this instance
GITHUB_WEBHOOK_WORKER_ENABLED=true

# ============================================================================
# ADDONS CONFIGURATION
# ============================================================================
# Optional comma-separated list of enabled addon IDs residing in ./addons/<addon-id>
# Example: ENABLED_ADDONS=my-addon,sample-plugin
ENABLED_ADDONS=
VITE_ENABLED_ADDONS=

# ============================================================================
# CONFIGURATION GUIDE
# ============================================================================
#
# QUICK START:
# 1. Copy this file to .env and replace the example passwords and secrets.
# 2. Configure URLs and S3_PUBLIC_URL for the host that users will access.
# 3. Provision nginx/ssl/cert.pem and nginx/ssl/key.pem (see DOCKER_SETUP.md).
# 4. Run: docker compose up -d
# The Compose file has no express, advanced, or SSL profiles. External services
# require adapting the Compose file as well as setting environment variables.
#
# GOOGLE LOGIN SETUP:
# ===================
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 credentials
# 3. Add authorized redirect URI: https://your-domain.com/api/auth/google/callback
# 4. Set GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL
# 5. Set VITE_ENABLE_GOOGLE_LOGIN=true
#
# ============================================================================
