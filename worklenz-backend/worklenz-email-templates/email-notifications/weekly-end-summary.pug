doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Your week in review
  body
    style.
      td { font-family: 'Helvetica Neue', helvetica, arial, sans-serif; background: #fff; margin: 0; padding: 0; border: 0; border-collapse: collapse; border-spacing: 0; }
      a { color: #1890ff; }
      .section-header { font-size: 1em; font-weight: 600; margin-top: 24px; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid #d8d8d8; color: #2b2b2b; }
      .task-meta { color: #6d6e6f; font-size: 13px; }
      .footer { color: #6d6d6d; font-size: 12px; }
      table.admin-table { width: 100%; border-collapse: collapse; font-size: 13px; }
      table.admin-table th { text-align: left; padding: 4px 8px; border-bottom: 1px solid #d8d8d8; color: #666; font-weight: 500; }
      table.admin-table td { padding: 4px 8px; border-bottom: 1px solid #f0f0f0; }
    div(style="margin:0;padding:0;background:#fff;text-align:left;font-size:15px;line-height:1.4;font-family:'Helvetica Neue',helvetica,'Segoe UI',arial,sans-serif;font-weight:400;")
      div(style='padding:15px 25px')
        table(style='width:100%;max-width:42em;')
          tbody
            tr
              td
                table(width='100%')
                  tbody
                    tr: td: img(width='50' height='50' src='https://s3.us-west-2.amazonaws.com/worklenz.com/assets/icon-96x96.png')
                    tr: td(style='height:0.625em')
                table(width='100%')
                  tbody
                    tr
                      td
                        h3(style='margin:0;line-height:1.2;font-size:1.3em') Hi #{userName},
                        p(style='color:#555;margin-top:8px;') Here is how your week wrapped up.

                    //- Completed This Week
                    if completed && completed.tasks && completed.tasks.length
                      tr
                        td
                          h4.section-header ASSIGNED TO ME — COMPLETED THIS WEEK
                          each task in completed.tasks
                            table(width='100%' style='margin-bottom:8px')
                              tr
                                td
                                  a(href=task.taskUrl style='color:#1890ff;text-decoration:underline;')= task.name
                                  br
                                  span.task-meta
                                    if workspaceCount > 1 && task.workspaceName
                                      | #{task.workspaceName} ·
                                    | #{task.projectName}
                                    if task.completedDay
                                      |  · Completed #{task.completedDay.trim()}
                          if completed.totalCount > completed.tasks.length
                            p.task-meta
                              | + #{completed.totalCount - completed.tasks.length} more.&nbsp;
                              a(href=managePreferencesUrl style='color:#1890ff') View all in Worklenz.

                    //- Still Due This Week
                    if stillDue && stillDue.tasks && stillDue.tasks.length
                      tr
                        td
                          h4.section-header ASSIGNED TO ME — STILL DUE THIS WEEK
                          each task in stillDue.tasks
                            table(width='100%' style='margin-bottom:8px')
                              tr
                                td
                                  a(href=task.taskUrl style='color:#1890ff;text-decoration:underline;')= task.name
                                  br
                                  span.task-meta
                                    if workspaceCount > 1 && task.workspaceName
                                      | #{task.workspaceName} ·
                                    | #{task.projectName}
                                    if task.dueDate
                                      |  · Due #{task.dueDate}
                          if stillDue.totalCount > stillDue.tasks.length
                            p.task-meta
                              | + #{stillDue.totalCount - stillDue.tasks.length} more.&nbsp;
                              a(href=managePreferencesUrl style='color:#1890ff') View all in Worklenz.

                    //- Became Overdue This Week
                    if becameOverdue && becameOverdue.tasks && becameOverdue.tasks.length
                      tr
                        td
                          h4.section-header ASSIGNED TO ME — BECAME OVERDUE THIS WEEK
                          each task in becameOverdue.tasks
                            table(width='100%' style='margin-bottom:8px')
                              tr
                                td
                                  a(href=task.taskUrl style='color:#1890ff;text-decoration:underline;')= task.name
                                  br
                                  span.task-meta
                                    if workspaceCount > 1 && task.workspaceName
                                      | #{task.workspaceName} ·
                                    | #{task.projectName}
                                    if task.dueDate
                                      |  · Was due #{task.dueDate}
                          if becameOverdue.totalCount > becameOverdue.tasks.length
                            p.task-meta
                              | + #{becameOverdue.totalCount - becameOverdue.tasks.length} more.&nbsp;
                              a(href=managePreferencesUrl style='color:#1890ff') View all in Worklenz.

                    //- All-Time Overdue (count card only)
                    if allTimeOverdueCount && allTimeOverdueCount > 0
                      tr
                        td
                          h4.section-header ASSIGNED TO ME — ALL-TIME OVERDUE (#{allTimeOverdueCount} tasks)
                          p(style='color:#555;') These tasks were overdue before this week.
                          a(href=managePreferencesUrl style='color:#1890ff;') View #{allTimeOverdueCount} overdue #{allTimeOverdueCount === 1 ? 'task' : 'tasks'} in Worklenz

                    //- Assigned by me — Completed This Week
                    if assignedByMeCompleted && assignedByMeCompleted.tasks && assignedByMeCompleted.tasks.length
                      tr
                        td
                          h4.section-header ASSIGNED BY ME — COMPLETED THIS WEEK
                          each task in assignedByMeCompleted.tasks
                            table(width='100%' style='margin-bottom:8px')
                              tr
                                td
                                  a(href=task.taskUrl style='color:#1890ff;text-decoration:underline;')= task.name
                                  br
                                  span.task-meta
                                    if task.assigneeName
                                      | Assigned to: #{task.assigneeName} ·
                                    if workspaceCount > 1 && task.workspaceName
                                      | #{task.workspaceName} ·
                                    | #{task.projectName}
                                    if task.completedDay
                                      |  · Completed #{task.completedDay.trim()}
                          if assignedByMeCompleted.totalCount > assignedByMeCompleted.tasks.length
                            p.task-meta
                              | + #{assignedByMeCompleted.totalCount - assignedByMeCompleted.tasks.length} more.&nbsp;
                              a(href=managePreferencesUrl style='color:#1890ff') View all in Worklenz.

                    //- Assigned by me — Became Overdue This Week
                    if assignedByMeBecameOverdue && assignedByMeBecameOverdue.tasks && assignedByMeBecameOverdue.tasks.length
                      tr
                        td
                          h4.section-header ASSIGNED BY ME — BECAME OVERDUE THIS WEEK
                          each task in assignedByMeBecameOverdue.tasks
                            table(width='100%' style='margin-bottom:8px')
                              tr
                                td
                                  a(href=task.taskUrl style='color:#1890ff;text-decoration:underline;')= task.name
                                  br
                                  span.task-meta
                                    if task.assigneeName
                                      | Assigned to: #{task.assigneeName} ·
                                    if workspaceCount > 1 && task.workspaceName
                                      | #{task.workspaceName} ·
                                    | #{task.projectName}
                                    if task.dueDate
                                      |  · Was due #{task.dueDate}
                          if assignedByMeBecameOverdue.totalCount > assignedByMeBecameOverdue.tasks.length
                            p.task-meta
                              | + #{assignedByMeBecameOverdue.totalCount - assignedByMeBecameOverdue.tasks.length} more.&nbsp;
                              a(href=managePreferencesUrl style='color:#1890ff') View all in Worklenz.

                    //- Admin team overview table (weekly end columns)
                    if adminOverview && adminOverview.length
                      tr
                        td
                          h4.section-header TEAM OVERVIEW
                          - var totalCompleted = 0
                          each ws in adminOverview
                            - totalCompleted += ws.totals.completed
                            p(style='font-weight:600;margin-bottom:6px;text-transform:uppercase;') #{ws.workspaceName}
                            table.admin-table
                              thead
                                tr
                                  th Team
                                  th Completed
                                  th Overdue (Wk)
                                  th All-Time
                                  th Next Week
                              tbody
                                each team in ws.teams
                                  tr
                                    td= team.teamName
                                    td= team.completed
                                    td= team.overdueThisWeek
                                    td= team.allTimeOverdue
                                    td= team.dueNextWeek
                                tr(style='font-weight:600;border-top:2px solid #d8d8d8;')
                                  td Total
                                  td= ws.totals.completed
                                  td= ws.totals.overdueThisWeek
                                  td= ws.totals.allTimeOverdue
                                  td= ws.totals.dueNextWeek
                          p(style='color:#555;margin-top:12px;') Your teams completed #{totalCompleted} #{totalCompleted === 1 ? 'task' : 'tasks'} this week.

                    tr
                      td(style='padding-top:20px')
                        a(href=managePreferencesUrl style='display:inline-block;background:#1890ff;color:#fff;padding:8px 20px;border-radius:4px;text-decoration:none;font-size:14px;') View my full task list in Worklenz

            tr
              td
                table(width='100%')
                  tbody
                    tr
                      td(style='padding-top:20px')
                        hr(style='border:0;border-bottom:1px solid #d8d8d8;')
                    tr
                      td(style='padding-top:10px;padding-bottom:10px')
                        p.footer
                          | You're receiving this because you have task notifications enabled in Worklenz.
                          br
                          a(href=managePreferencesUrl style='color:#6d6d6d;text-decoration:underline;') Manage preferences
                          |  ·
                          a(href=unsubscribeUrl style='color:#6d6d6d;text-decoration:underline;') Unsubscribe from all task emails
